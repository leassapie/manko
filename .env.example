# ── Required ───────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# From https://my.telegram.org (API development tools)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# ── Optional ───────────────────────────────────────────
# Your Telegram user ID
OWNER_ID=0

# Soft max upload size in MB (MTProto ~2000; Premium ~4000)
MAX_FILE_MB=2000

# Where to store temporary downloads
DOWNLOAD_ROOT=downloads

# Where per-user cookies.txt are kept
COOKIES_DIR=user_cookies

# Where user thumbnails are stored
THUMB_DIR=thumbnails

# Keep finished files after sending? (true/false)
KEEP_FILES=false

# Concurrent download workers
WORKERS=2

# Kurigram session name
SESSION_NAME=hstream_tg

# Destination channels (bot must be admin)
# Numeric id like -1001234567890 or @channelusername
UPLOAD_CHANNEL=
DUMP_CHANNEL=

# ── Heroku auto-update ─────────────────────────────────
# On every dyno start, start.sh runs the bot which pulls this repo.
UPSTREAM_REPO=https://github.com/zenin-373/Hstream-TG.git
UPSTREAM_BRANCH=main
